$!RenameDataSetZone 
  Zone = 38
  Name = 'COARSE'
$!RenameDataSetZone 
  Zone = 39
  Name = 'MEDIUM'
$!RenameDataSetZone 
  Zone = 40
  Name = 'FINE'
$!FrameLayout 
  ShowBorder = No
  ShowHeader = No
  HeaderColor = Red
  XYPos
    {
    X = 1
    Y = 0.25
    }
  Width = 9
  Height = 8
$!ThreeDAxis 
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
$!PlotType  = XYLine
$!FrameName  = 'Case242finalIceShape'
$!GlobalTime 
  SolutionTime = 30
$!DeleteLineMaps 
$!ActiveLineMaps  =  [28-32]
$!GlobalLinePlot 
  DataLabels
    {
    DistanceSkip = 5
    }
  Legend
    {
    Show = Yes
    TextShape
      {
      Height = 2
      }
    Box
      {
      BoxType = Filled
      Margin = 5
      LineThickness = 0.4
      }
    XYPos
      {
      X = 97.5
      Y = 50
      }
    AnchorAlignment = MiddleRight
    }
